<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary"
    tools:context=".Bio_one_activity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/bioToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#FF1C8387"
            app:navigationIconTint="#F5FAF9"
            app:title="@string/app_name"
          app:titleMarginStart="@dimen/_10sdp"
            app:titleTextColor="@color/white" />


    </com.google.android.material.appbar.AppBarLayout>

    <ListView
        android:id="@+id/listViewItem1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/adContainer"
        android:layout_marginTop="?attr/actionBarSize"
        android:layout_marginBottom="@dimen/_8sdp"
        android:background="@color/white" />

    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp">
        <!-- Banner Ad will be placed here -->
    </FrameLayout>

</RelativeLayout>